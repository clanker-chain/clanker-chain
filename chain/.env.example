# Copy to chain/.env and fill in (Foundry auto-loads .env from this directory).
#   cp .env.example .env

# Immutable constructor fees (wei). Zero = free registration (Sepolia smoke).
OPERATOR_FEE_WEI=0
BOT_FEE_WEI=0

# Must be a non-zero address that can accept plain ETH (EOA is fine at fee=0).
# Use your Coinbase Wallet Ethereum address.
FEE_RECIPIENT=0xYourEthereumAddressHere

# Base Sepolia RPC (public endpoint is rate-limited; prefer CDP/Alchemy for indexer).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional overrides for npm scripts
# CHAIN_RPC_URL=http://127.0.0.1:8545
# FOUNDRY_ACCOUNT=deployer
# DEPLOYER_PRIVATE_KEY=   # local Anvil only — prefer `cast wallet import deployer` for Sepolia
