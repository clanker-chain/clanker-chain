# Public auth front: /nonce, /health, /pair-nonce, /pair.
# /auth and /acl stay on the Docker network (Mosquitto only).
mqtt-auth.clanker-chain.com {
	tls /etc/letsencrypt/live/mqtt.clanker-chain.com/fullchain.pem /etc/letsencrypt/live/mqtt.clanker-chain.com/privkey.pem

	handle /nonce* {
		reverse_proxy mqtt-auth:9090
	}
	handle /pair-nonce* {
		reverse_proxy mqtt-auth:9090
	}
	handle /pair* {
		reverse_proxy mqtt-auth:9090
	}
	handle /health* {
		reverse_proxy mqtt-auth:9090
	}
	handle {
		respond "Not Found" 404
	}
}

# Public site (Astro dist). Caddy obtains the apex cert (DNS must point here).
# mqtt / mqtt-auth keep the certbot cert above.
clanker-chain.com, www.clanker-chain.com {
	root * /srv/website
	encode gzip
	try_files {path} {path}/ /404.html
	file_server
}

# MQTT hostname: ACME webroot + placeholder (broker is mqtts on :8883, not HTTPS).
mqtt.clanker-chain.com {
	tls /etc/letsencrypt/live/mqtt.clanker-chain.com/fullchain.pem /etc/letsencrypt/live/mqtt.clanker-chain.com/privkey.pem

	handle /.well-known/acme-challenge/* {
		root * /var/www/certbot
		file_server
	}
	handle {
		respond "clanker-chain mqtt hub" 200
	}
}
