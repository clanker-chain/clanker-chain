# Copy to mqtt-service/.env on the public hub host (gitignored).
#   cp .env.public.example .env

REGISTRY_ADDRESS=0xD650467f9D7A20f37E55ec23Ca1c711598f97958
# Shared hub Facts path: use an operator-owned / authenticated Base Sepolia RPC
# (Alchemy, CDP, self-hosted node, etc.). Do not commit real URLs with API keys.
# Invitees may keep public https://sepolia.base.org for their own clients.
CHAIN_RPC_URL=https://YOUR_PROVIDER_BASE_SEPOLIA_RPC
CHAIN_RPC_TIMEOUT_MS=10000

# Optional: Let's Encrypt registration contact (issue-certs.sh).
# CERTBOT_EMAIL=ops@example.com

# Stable Docker project/volume prefix on the droplet.
COMPOSE_PROJECT_NAME=clanker-mqtt
