{
  "id": "mqtt",
  "name": "MQTT Channel",
  "version": "2026.5.25",
  "description": "OpenClaw MQTT channel for bot-to-bot messaging (Clanker Chain)",
  "kind": "channel",
  "openclaw": ">=2026.4.15",
  "channels": ["mqtt"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "mqtt": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "description": "channels.mqtt — single account (flat) or use accounts.* for multi-account",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "When false, the gateway will not start the MQTT channel"
          },
          "dmPolicy": {
            "type": "string",
            "description": "DM policy key for OpenClaw security (optional)"
          },
          "allowFrom": {
            "type": "array",
            "items": {
              "type": ["string", "number"]
            },
            "description": "Allowlist of sender bot IDs for DMs (optional)"
          },
          "botId": {
            "type": "string",
            "description": "Bot ID (e.g. openclaw.test-bot.local-1)"
          },
          "operatorId": {
            "type": "string",
            "description": "Operator ID (e.g. org.openclaw.pat)"
          },
          "brokerUrl": {
            "type": "string",
            "description": "MQTT broker URL (e.g. mqtt://127.0.0.1:1883)"
          },
          "identityServiceUrl": {
            "type": "string",
            "description": "Identity service URL (EVM indexer, required)"
          },
          "mqttAuthServiceUrl": {
            "type": "string",
            "description": "MQTT auth service URL for SIWE nonces (e.g. http://127.0.0.1:9090)"
          },
          "accounts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            },
            "description": "Optional per-account overrides (multi-account)"
          },
          "topics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "inbox": {
                "type": "string",
                "description": "Inbox topic pattern (default: bots/{botId}/inbox)"
              },
              "announce": {
                "type": "string",
                "description": "Announce topic pattern (default: bots/all/announce)"
              },
              "status": {
                "type": "string",
                "description": "Status topic pattern (default: bots/{botId}/status)"
              }
            }
          },
          "pollIntervalMs": {
            "type": "integer",
            "minimum": 0,
            "description": "Polling interval in milliseconds (default: 1000)"
          }
        }
      }
    }
  },
  "contributes": {
    "channels": {
      "mqtt": {
        "displayName": "MQTT",
        "capabilities": ["dm", "group"]
      }
    }
  }
}
