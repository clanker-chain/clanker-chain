{
  "name": "@clanker-chain/mqtt-channel-plugin",
  "version": "2026.7.29",
  "description": "OpenClaw channel plugin: MQTT bot-to-bot messaging (Clanker Chain)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "bun test test/wire-format.test.ts test/deliver-policy.test.ts test/accounts.test.ts"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "mqtt",
      "label": "MQTT",
      "blurb": "Connect OpenClaw to MQTT for bot-to-bot messaging."
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.15"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "dependencies": {
    "@clanker-chain/identity-node-client": "2026.7.29",
    "@clanker-chain/mqtt-node-client": "2026.5.25-2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
